doctype html
html(lang="da")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Vælg spil
    link(rel="stylesheet", href="/MainMenu.css")
    script(type="module", src="/lobby.js", defer)
  body
    main.layout.lobby-layout
      section.panel.game-lobby
        a.lobby-back(href="/") Tilbage til menu
        h1 Multiplayer-lobby
        p.welcome-text #{userName}

        table#waiting-players-table
          caption Spillere:
          thead
            tr
              th(scope="col") Spiller
          tbody#waiting-players
        p#lobby-status(aria-live="polite")