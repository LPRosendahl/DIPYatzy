doctype html
html(lang="da")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Spil Lobby
    link(rel="stylesheet", href="/MainMenu.css")
  body
    - const currentUser = userName || ""
    - const scoreEntries = scores || [""]

    .layout.lobby-layout
      section.panel.lobby-left
        .profile-header
          .avatar-box
            if avatarUrl
              img(src=avatarUrl, alt=`Avatar for ${currentUser}`)
            else
              | 😄
          .name-section
            p.name-text Navn: #{currentUser}

        a.new-game-btn(href=newGameUrl || "/index.html") New Game

      section.panel.lobby-right
        .score-title-box
          h2 Scorelist:
        .leaderboard-list
          each entry in scoreEntries
            .leaderboard-item= entry