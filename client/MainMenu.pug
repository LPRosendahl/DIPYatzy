doctype html
html(lang="da")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Spil Lobby
    link(rel="stylesheet", href="/MainMenu.css")
    script(type="module", src="/gui.js", defer)
  body
    - const currentUser = userName || ""
    - const scoreEntries = scores || []

    .layout.lobby-layout
      section.panel.lobby-left
        .profile-header
          .avatar-box
            if avatarUrl
              img(src=avatarUrl, alt=`Avatar for ${currentUser}`)
            else
              | 😄
          .name-section
            p.name-text Navn: #{currentUser}

        form#username-form
          label(for="username") Brugernavn:
          input#username(
            type="text",
            name="username",
            value=currentUser,
            required,
            maxlength="30"
          )
          button.new-game-btn(type="submit", name="mode", value="singleplayer") Singleplayer
          button.new-game-btn(type="submit", name="mode", value="multiplayer") Multiplayer

      section.panel.lobby-right
        .score-title-box
          h2 Scorelist:
        .leaderboard-list#leaderboard-list
          each entry in scoreEntries
            .leaderboard-item #{entry.username} - #{entry.score}
          else
            .leaderboard-item Ingen afsluttede spil endnu